<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission. The free tier must be provably offline, and the
         cleanest proof is that the app cannot reach the network at all. -->

    <application
        android:name="com.shuddhatype.ShuddhaTypeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ShuddhaType">

        <service
            android:name="com.shuddhatype.ime.ShuddhaTypeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- adjustResize on both screens because both now hold text fields.
             The default lets the keyboard sit on top of the window, which hid
             the shortcut fields and the थप्ने button under it — the user could
             not see what they were typing or reach the button. Resizing shrinks
             the window instead, and since each screen's root is a ScrollView,
             the focused field is scrolled into view on its own. -->
        <activity
            android:name="com.shuddhatype.ime.SetupActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the rendered word-sticker to whichever app is being typed
             into. commitContent hands over a URI, not a bitmap, so something
             has to answer when the other app opens it.

             exported, because the receiving app is a different process and has
             to be able to read it — but it only ever serves one directory
             inside this app's own cache, read-only, and grants are handed out
             per-send by commitContent rather than standing open. -->
        <provider
            android:name="com.shuddhatype.ime.StickerProvider"
            android:authorities="com.shuddhatype.stickers"
            android:exported="true"
            android:grantUriPermissions="true" />

        <activity
            android:name="com.shuddhatype.ime.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Its own process, its own (framework, not app-defined) theme, no
             other app resource. If the crash we're reporting is itself a
             resource/theme problem, this screen must not share the cause. -->
        <activity
            android:name="com.shuddhatype.crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:launchMode="singleTask" />
    </application>
</manifest>
