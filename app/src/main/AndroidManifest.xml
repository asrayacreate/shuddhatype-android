<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission. The free tier must be provably offline, and the
         cleanest proof is that the app cannot reach the network at all. -->

    <application
        android:name="com.shuddhatype.ShuddhaTypeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ShuddhaType">

        <service
            android:name="com.shuddhatype.ime.ShuddhaTypeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.inputmethod"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name="com.shuddhatype.ime.SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.shuddhatype.ime.SettingsActivity" android:exported="false" />

        <!-- Its own process, its own (framework, not app-defined) theme, no
             other app resource. If the crash we're reporting is itself a
             resource/theme problem, this screen must not share the cause. -->
        <activity
            android:name="com.shuddhatype.crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:launchMode="singleTask" />
    </application>
</manifest>
